{
  "manifest": "selftest",
  "description": "H01-H04 runner self-tests plus a fake-transport case and a normal minimal pass. Each case declares expectVerdict; run with -SelfTest so Run-Acceptance asserts the runner classified it correctly. Run the GPU-blocked case with -DisableCapability gpu-gl to exercise that branch on a machine that has a GPU.",
  "cases": [
    {
      "id": "H01a-intentional-nonzero-exit",
      "tier": "W",
      "profiles": ["selftest", "pr"],
      "description": "A child that exits nonzero must be FAILED, not a graceful pass.",
      "requires": [],
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{ACCEPTANCE}\\fixtures\\exit-nonzero.ps1"],
      "fixture": "fixtures/exit-nonzero.ps1",
      "expectExit": 0,
      "deadlineSec": 15,
      "expectVerdict": "FAILED"
    },
    {
      "id": "H01b-crashing-fixture",
      "tier": "W",
      "profiles": ["selftest", "pr"],
      "description": "A crashing child (FailFast) must be FAILED with crash evidence and logs preserved.",
      "requires": [],
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{ACCEPTANCE}\\fixtures\\crash.ps1"],
      "fixture": "fixtures/crash.ps1",
      "expectExit": 0,
      "deadlineSec": 15,
      "expectVerdict": "FAILED"
    },
    {
      "id": "H01c-passing-fixture",
      "tier": "W",
      "profiles": ["selftest", "pr"],
      "description": "A cleanly-succeeding child must be PASSED.",
      "requires": [],
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{ACCEPTANCE}\\fixtures\\pass.ps1"],
      "fixture": "fixtures/pass.ps1",
      "expectExit": 0,
      "deadlineSec": 15,
      "expectVerdict": "PASSED"
    },
    {
      "id": "H02-hanging-child-times-out",
      "tier": "W",
      "profiles": ["selftest", "pr"],
      "description": "A child that hangs past its deadline must TIMEOUT; only its tree is killed and the parent survives.",
      "requires": [],
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{ACCEPTANCE}\\fixtures\\hang.ps1"],
      "fixture": "fixtures/hang.ps1",
      "expectExit": 0,
      "deadlineSec": 2,
      "expectVerdict": "TIMEOUT"
    },
    {
      "id": "H03-missing-fixture",
      "tier": "U",
      "profiles": ["selftest", "pr"],
      "description": "A declared fixture that does not exist must be MISSING (never a pass).",
      "requires": [],
      "command": "powershell",
      "args": ["-NoProfile", "-Command", "exit 0"],
      "fixture": "fixtures/does-not-exist.ps1",
      "expectExit": 0,
      "deadlineSec": 15,
      "expectVerdict": "MISSING"
    },
    {
      "id": "H03-missing-test-zero-count",
      "tier": "U",
      "profiles": ["selftest", "pr"],
      "description": "A filter that matches zero tests must be a FAILURE (minTests unmet), even though the process exits 0.",
      "requires": [],
      "command": "{BIN}\\CosmicTests.exe",
      "args": ["--test-case=__no_such_test_zzz__", "--no-intro=true"],
      "minTests": 1,
      "expectExit": 0,
      "deadlineSec": 60,
      "expectVerdict": "FAILED"
    },
    {
      "id": "H03-missing-golden",
      "tier": "G",
      "profiles": ["selftest", "gpu"],
      "description": "A declared-but-missing golden must be MISSING; acceptance mode never regenerates it.",
      "requires": [],
      "command": "powershell",
      "args": ["-NoProfile", "-Command", "exit 0"],
      "golden": "goldens/does-not-exist.png",
      "expectExit": 0,
      "deadlineSec": 15,
      "expectVerdict": "MISSING"
    },
    {
      "id": "H04-serial-hardware-blocked",
      "tier": "W",
      "profiles": ["selftest", "serial"],
      "description": "A case needing real serial hardware is ENVIRONMENT_BLOCKED (no usable COM per campaign) — never a phantom pass.",
      "requires": ["serial-device"],
      "command": "{BIN}\\CosmicTests.exe",
      "args": ["--test-case=SerialPort*"],
      "expectExit": 0,
      "deadlineSec": 60,
      "expectVerdict": "ENVIRONMENT_BLOCKED"
    },
    {
      "id": "H04-gpu-blocked",
      "tier": "G",
      "profiles": ["selftest", "gpu"],
      "description": "A case needing a GPU/GL context is ENVIRONMENT_BLOCKED when that capability is absent (self-test forces gpu-gl off to exercise the branch).",
      "requires": ["gpu-gl"],
      "command": "{BIN}\\CosmicTests.exe",
      "args": ["--test-case=*camera2d*"],
      "expectExit": 0,
      "deadlineSec": 60,
      "expectVerdict": "ENVIRONMENT_BLOCKED"
    },
    {
      "id": "H04-fake-transport-runs",
      "tier": "W",
      "profiles": ["selftest", "pr", "serial"],
      "description": "The fake serial transport case still RUNS (no hardware) and identifies itself as fake in evidence.",
      "requires": [],
      "transport": "fake",
      "command": "{BIN}\\CosmicTests.exe",
      "args": ["--test-case=WO-04 seam*", "--no-intro=true"],
      "minTests": 5,
      "expectExit": 0,
      "deadlineSec": 60,
      "expectVerdict": "PASSED"
    },
    {
      "id": "Hnormal-minimal-pass",
      "tier": "U",
      "profiles": ["selftest", "pr"],
      "description": "A normal minimal case passes end to end through the runner.",
      "requires": [],
      "seed": 0,
      "command": "{BIN}\\CosmicTests.exe",
      "args": ["--test-case=WO-04 seam: an injected transport replaces port discovery", "--no-intro=true"],
      "minTests": 1,
      "expectExit": 0,
      "deadlineSec": 60,
      "expectVerdict": "PASSED"
    }
  ]
}
