# Cosmic project manifest — @PROJECT_NAME@
# Consumed by the standalone PlayerLayer (E13) and Starforge.
name          = "@PROJECT_NAME@"
kind          = "game"
startup_scene = "scenes/Menu.cscene"
startup_flow  = "flows/Main.cflow"
fixed_dt_hz   = 60

[window]
title  = "@PROJECT_NAME@"
width  = 1280
height = 720
