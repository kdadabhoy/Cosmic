<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest for CosmicApp.exe.

  Declares Per-Monitor V2 DPI awareness at the OS level. GLFW also opts in at
  runtime, but the manifest is the Windows-correct declaration: it removes the
  first-frame window before any code runs from ever being DWM-scaled, which is
  exactly the class of issue the 2026-06-26 borderless-chrome DPI fix addressed
  (see docs/engineering-notes/borderless-window-dpi.md).

  longPathAware lifts the MAX_PATH limit for deep asset/recording paths.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
